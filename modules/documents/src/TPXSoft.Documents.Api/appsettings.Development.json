{
  "ConnectionStrings": {
    "DocumentsDb": "Host=localhost;Port=5432;Database=tpxsoft;Username=tpxsoft;Password=tpxsoft"
  },
  "Documents": {
    "Jwt": {
      "Issuer": "tpxsoft-auth",
      "Audience": "tpxsoft",
      // Must match Auth's Auth:Jwt:SigningKey exactly -- this module validates tokens Auth
      // issues, it does not issue its own. Local development only, obviously not a production
      // value. Override via the Documents__Jwt__SigningKey env var or user-secrets everywhere
      // else; never commit a real key.
      "SigningKey": "dev-only-jwt-signing-key-do-not-use-in-production-01234567"
    },
    "MaxUploadBytes": 26214400,
    "ApplyMigrationsAtStartup": true,
    "Cors": {
      "AllowedOrigins": ["http://localhost:4200"]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
