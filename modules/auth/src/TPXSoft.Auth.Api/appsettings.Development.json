{
  "ConnectionStrings": {
    "AuthDb": "Host=localhost;Port=5432;Database=tpxsoft;Username=tpxsoft;Password=tpxsoft"
  },
  "Auth": {
    "Jwt": {
      "Issuer": "tpxsoft-auth",
      "Audience": "tpxsoft",
      "AccessTokenLifetimeMinutes": 15,
      // Local development only -- obviously not a production value. Override via the
      // Auth__Jwt__SigningKey env var or user-secrets everywhere else; never commit a real key.
      "SigningKey": "dev-only-jwt-signing-key-do-not-use-in-production-01234567"
    },
    "RefreshTokenLifetimeDays": 7,
    "ApplyMigrationsAtStartup": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
