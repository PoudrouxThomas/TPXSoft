{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "node tools/harness/hooks/block-generated.mjs" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node tools/harness/hooks/verify-on-save.mjs" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node tools/harness/hooks/stop-verify.mjs" }]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run verify:*)",
      "Bash(npm run format:*)",
      "Bash(npm run openapi:accept:*)",
      "Bash(npm run hooks:selftest:*)",
      "Bash(node tools/harness/*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet ef:*)",
      "Bash(docker compose:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./artifacts/**)",
      "Read(./**/bin/**)",
      "Read(./**/obj/**)",
      "Read(./**/TestResults/**)",
      "Read(./node_modules/**)"
    ]
  }
}
