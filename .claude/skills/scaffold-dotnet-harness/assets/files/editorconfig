root = true

# The single source of style truth. Anything a tool can decide should never consume
# model attention, so this file is deliberately opinionated and `dotnet format` is the
# only arbiter -- there is no second style document to disagree with it.

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4
max_line_length = 120

# IDE0055 is what makes `dotnet format --verify-no-changes` fail on formatting rather
# than quietly reformat on someone else's machine later.
dotnet_diagnostic.IDE0055.severity = warning

csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
csharp_prefer_braces = when_multiline:silent
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_expression_bodied_methods = when_on_single_line:silent

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_style_readonly_field = true:warning

dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

[*.{csproj,props,targets,xml}]
indent_size = 2

[*.{json,yml,yaml,mjs,js,ts}]
indent_size = 2

# Generated. Excluded from style enforcement so a generator's formatting never becomes
# a build failure someone has to hand-fix -- which is the moment the guard gets removed.
[**/Migrations/*.cs]
dotnet_diagnostic.IDE0055.severity = none
generated_code = true
